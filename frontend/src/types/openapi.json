      "get": {
        "summary": "Trip Status",
        "operationId": "trip_status_api_trips__trip_id__status_get",
        "parameters": [
          {
            "name": "trip_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Trip Id"
