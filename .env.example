# Copy to travel_planner/.env. Keep that file private.
# Use a Gemini API key from a free-tier-eligible Google AI Studio project.
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional: Duffel Developer test mode token (must start with duffel_test_).
# Global trips work without it, but no sandbox flight offers are shown.
DUFFEL_TEST_TOKEN=
